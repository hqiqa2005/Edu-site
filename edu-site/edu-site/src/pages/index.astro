---
import Layout from '../layouts/Layout.astro'; import { softwares, levels, subjects } from '../data/software';
const featured=softwares.filter(s=>s.featured);
const jeuxHtml = [
  { titre: 'Calcul champion', fichier: 'calcul-champion.html', emoji: '🔢' },
  { titre: 'Détective logique', fichier: 'detective-logique.html', emoji: '🧩' },
  { titre: 'Maths aventure', fichier: 'maths-aventure.html', emoji: '🚀' },
  { titre: 'Petit scientifique', fichier: 'petit-scientifique.html', emoji: '🔬' },
  { titre: 'Premiers nombres', fichier: 'premiers-nombres.html', emoji: '🌱' },
];
---
<Layout title="Petits Explorateurs — Apprendre en s’amusant"><section class="hero"><div><div class="eyebrow">🎒 CP → CM2 · 6–11 ans</div><h1>Apprendre devient une <span>aventure !</span> 🚀</h1><p>Des activités éducatives simples, amusantes et pensées pour les enfants. Choisis ton niveau, ta matière et pars explorer.</p><div class="actions"><a class="cta" href="/logiciels">🎮 Explorer les activités</a><a class="text-link" href="#comment-ca-marche">Comment ça marche ? ↓</a></div></div><div class="hero-art" aria-hidden="true"><div class="stars">✦　✧　✦</div><div class="planet">🧒</div><div class="orbit">📚　🔢　🔬　🧩</div></div></section>
<section class="section intro" id="comment-ca-marche"><div><span class="eyebrow">🌈 Pour apprendre autrement</span><h2>Une plateforme simple pour toute la famille</h2><p>Les enfants explorent seuls. Les adultes retrouvent facilement les activités par niveau et par matière.</p></div><div class="feature-row"><div><b>1.</b><strong>Choisir</strong><span>un niveau ou une matière</span></div><div><b>2.</b><strong>Explorer</strong><span>une activité adaptée</span></div><div><b>3.</b><strong>Progresser</strong><span>à son propre rythme</span></div></div></section>
<section class="section"><div class="section-head"><div><h2>🎒 Choisis ton niveau</h2><p>Des contenus adaptés à chaque étape de l’école primaire.</p></div><a class="see-all" href="/logiciels">Voir tout →</a></div><div class="level-grid">{levels.map((l,i)=><a class="level" href={`/logiciels?level=${l}`}><span>{['🌱','⭐','🚀','🧠','🏆'][i]}</span><strong>{l}</strong><small>Explorer</small></a>)}</div></section>
<section class="section soft"><div class="section-head"><div><h2>📚 Choisis ta matière</h2><p>Apprendre, réfléchir, expérimenter et créer.</p></div></div><div class="subject-grid">{subjects.map((s,i)=><a class={`subject subject-${i}`} href={`/logiciels?subject=${encodeURIComponent(s)}`}><span>{['➕','📖','🔬','🧩'][i]}</span><strong>{s}</strong><small>Découvrir →</small></a>)}</div></section>
<section class="section"><div class="section-head"><div><span class="eyebrow">⭐ Sélection</span><h2>Les activités à découvrir</h2></div><a class="see-all" href="/logiciels">Catalogue complet →</a></div><div class="software-grid">{featured.map(s=><article class="card"><div class={`card-top ${s.color}`}>{s.icon}</div><div class="card-body"><div class="meta"><span>{s.level}</span><span>{s.subject}</span></div><h3>{s.title}</h3><p>{s.description}</p><div class="card-foot"><span>⏱ {s.duration}</span><a class="mini-btn" href={`/jeux/${s.slug}.html`}>Jouer</a></div></div></article>)}</div></section><section class="trust"><section class="section"><div class="section-head"><div><span class="eyebrow">🎮 Jeux éducatifs</span><h2>Jouer et apprendre</h2><p>Choisis un jeu pour commencer.</p></div></div><div class="software-grid">{jeuxHtml.map((jeu) => (<article class="card"><div class="card-top">{jeu.emoji}</div><div class="card-body"><h3>{jeu.titre}</h3><div class="card-foot"><a class="mini-btn" href={`/jeux/${jeu.fichier}`}>Jouer →</a></div></div></article>))}</div></section><div><span class="big">🛡️</span><div><h2>Un espace pensé pour les enfants</h2><p>Interface lisible, navigation simple, aucune publicité intrusive et une attention particulière portée à l’accessibilité.</p></div></div><a class="secondary cta" href="/parents">Espace adultes →</a></section></Layout>
