---
import Layout from '../../layouts/Layout.astro'; import { softwares } from '../../data/software';
export function getStaticPaths(){return softwares.map(s=>({params:{slug:s.slug},props:{software:s}}));} const {software:s}=Astro.props;
---
<Layout title={`${s.title} — Petits Explorateurs`} description={s.description}><section class="product"><div><a class="back" href="/logiciels">← Retour au catalogue</a><div class={`preview ${s.color}`} aria-label={`Illustration de ${s.title}`}>{s.icon}</div></div><div class="product-copy"><div class="meta"><span>{s.level}</span><span>{s.subject}</span></div><h1>{s.title}</h1><p class="lead">{s.description}</p><div class="stats"><span>👦 {s.age}</span><span>⏱ {s.duration}</span><span>💻 {s.mode}</span></div><h2>🎯 Objectifs pédagogiques</h2><ul class="goals">{s.goals.map((g,i)=><li><span>{['✓','★','➜'][i%3]}</span>{g}</li>)}</ul><div class="actions"><a class="cta" href="#bientot">🎮 Jouer en ligne</a><a class="cta secondary" href="#bientot">⬇ Télécharger</a></div><p id="bientot" class="note">Cette version du site prépare le catalogue. Le jeu et le téléchargement pourront être reliés ici dans la prochaine étape.</p></div></section></Layout>
