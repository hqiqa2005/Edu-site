---
import Layout from '../../layouts/Layout.astro'; import { softwares, levels, subjects } from '../../data/software';
const level=Astro.url.searchParams.get('level')||''; const subject=Astro.url.searchParams.get('subject')||''; const filtered=softwares.filter(s=>(!level||s.level===level)&&(!subject||s.subject===subject));
---
<Layout title="Activités éducatives — Petits Explorateurs"><section class="page-head"><span class="eyebrow">🎮 Catalogue</span><h1>À toi de jouer !</h1><p>Choisis un niveau ou une matière pour trouver une activité adaptée.</p></section><section class="section catalog"><div class="filters"><a class={`filter ${!level&&!subject?'active':''}`} href="/logiciels">Tout</a>{levels.map(l=><a class={`filter ${level===l?'active':''}`} href={`/logiciels?level=${l}`}>{l}</a>)}{subjects.map(s=><a class={`filter ${subject===s?'active':''}`} href={`/logiciels?subject=${encodeURIComponent(s)}`}>{s}</a>)}</div><p class="result-count"><strong>{filtered.length}</strong> activité{filtered.length>1?'s':''} {level?`pour ${level}`:''}{subject?` en ${subject}`:''}</p>{filtered.length?<div class="software-grid">{filtered.map(s=><article class="card"><div class={`card-top ${s.color}`}>{s.icon}</div><div class="card-body"><div class="meta"><span>{s.level}</span><span>{s.subject}</span></div><h2>{s.title}</h2><p>{s.description}</p><div class="card-foot"><span>⏱ {s.duration}</span><a class="mini-btn" href={`/jeux/${s.slug}.html`}>Jouer →</a></div></div></article>)}</div>:<div class="empty"><strong>😯 Aucune activité trouvée.</strong><p>Essaie un autre niveau ou une autre matière.</p><a class="mini-btn" href="/logiciels">Afficher tout</a></div>}</section></Layout>
