---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Parents & enseignants — Petits Explorateurs"><section class="page-head"><span class="eyebrow">🛡️ Espace adultes</span><h1>Parents & enseignants</h1><p>Un accès séparé pour consulter les informations pédagogiques et accompagner l’enfant.</p></section><section class="parent-box"><div class="adult-icon">🔐</div><h2>Vérification simple</h2><p>Pour accéder à cet espace de démonstration, résous ce petit calcul.</p><label for="answer">Combien font <strong>7 + 5</strong> ?</label><input id="answer" type="number" inputmode="numeric" autocomplete="off"/><button class="cta" id="check">Vérifier</button><p id="message" class="message" role="status"></p><div class="adult-links"><a href="/accessibilite">♿ Accessibilité</a><a href="/confidentialite">🔒 Confidentialité</a></div></section><script>const a=document.querySelector('#answer');const b=document.querySelector('#check');const m=document.querySelector('#message');b?.addEventListener('click',()=>{if((a as HTMLInputElement).value==='12'){m.textContent='Bravo ! L’espace adultes est prêt pour accueillir les ressources pédagogiques.';m.className='message success'}else{m.textContent='Essaie encore 🙂';m.className='message error'}});</script></Layout>
